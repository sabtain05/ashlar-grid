{
  "name": "ashlar-grid",
  "version": "1.0.0",
  "description": "Zero-dependency headless dynamic-height masonry virtualization engine powered by batched ResizeObserver and O(log N) spatial indexing.",
  "keywords": [
    "masonry",
    "virtualization",
    "virtual-grid",
    "dynamic-height",
    "headless",
    "resize-observer",
    "60fps",
    "pinterest-grid",
    "typescript",
    "zero-dependency"
  ],
  "license": "MIT",
  "author": {
    "name": "Sabtain Ali",
    "url": "https://github.com/sabtain05"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabtain05/ashlar-grid.git"
  },
  "bugs": {
    "url": "https://github.com/sabtain05/ashlar-grid/issues"
  },
  "homepage": "https://github.com/sabtain05/ashlar-grid#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
